# Django Settings
FACETS_SERVICE_SECRET_KEY=your-very-secret-key-here-change-in-production

# Database Settings
FACETS_DB_NAME=facets_db
FACETS_DB_USERNAME=facets_user
FACETS_DB_PASSWORD=facets_password
FACETS_DB_URL=localhost
FACETS_DB_PORT=5432

# RabbitMQ Settings
FACETS_RABBITMQ_URL=localhost:5672
FACETS_RABBITMQ_USERNAME=facets_rabbitmq_user
FACETS_RABBITMQ_PASSWORD=facets_rabbitmq_password

# LDAP Settings
FACETS_AUTH_LDAP_SERVER_URI=ldap://your-ldap-server

# Facets Session Settings
FACETS_BASE_WORK_DIR=/app/work
FACETS_PORT_RANGE=8001-8100
FACETS_TRAEFIK_CONFIG=/app/traefik
FACETS_IMAGE=facets:latest
FACETS_CONTAINER_PORT=3838/tcp